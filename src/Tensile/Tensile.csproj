<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tensile</RootNamespace>
    <AssemblyName>Tensile</AssemblyName>

    <!-- Public API is documented; a missing doc comment on a public member is
         a build error, which is the only reliable way to keep it that way. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- The two compiler-held invariants (docs/security-design.md, I4 and I7).
         No unsafe code in the public assembly: every pointer lives in
         Tensile.Kernels, behind the KernelEntry seam. And every integer
         operation here is checked, so a size or offset that would wrap throws
         instead of addressing the wrong memory. Sizes are computed in long
         and range-checked before they get here; this is the net under that. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

    <!-- Every .NET analyzer rule, as errors (TreatWarningsAsErrors). The
         handful this design deliberately contradicts are switched off in
         this directory's .editorconfig, each with its reason. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Keep JIT inlining decisions from shifting between tiers while measuring. -->
    <TieredPGO>false</TieredPGO>

    <PackageId>Tensile</PackageId>
    <Description>Dense linear algebra for .NET, real and complex, in managed code: blocked GEMM with hand-written AVX-512/AVX2 micro-kernels at parity with BLIS on one core, LU with partial pivoting, 1-norm condition estimation, and the matrix exponential and its action (Al-Mohy &amp; Higham). No native dependencies.</Description>
    <PackageTags>linear-algebra;matrix;gemm;lu;complex;matrix-exponential;expm;numerics;simd</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Tensile.Kernels.dll travels inside this package rather than as a
         package of its own: see IncludeKernelAssembly below. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeKernelAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets: the kernel assembly is not a package dependency. Without
         it, pack writes a dependency on a "Tensile.Kernels" package that does
         not exist and leaves the DLL out, so the package cannot be restored,
         which is what it did until the package smoke test existed. -->
    <ProjectReference Include="../Tensile.Kernels/Tensile.Kernels.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!--
    One package, two assemblies. The split between the public assembly (no
    unsafe code) and the internal kernel assembly (all of it) is a security
    property, docs/security-design.md section 5.6, and it survives packaging:
    both DLLs go into lib/, so a consumer references Tensile.dll and reaches
    the kernels only through it.
  -->
  <Target Name="IncludeKernelAssembly" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage
        Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Filename)' == 'Tensile.Kernels'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The tests reach internal members such as the view buffers and the
         per-kernel workspace factory, so kernel-generic contracts can drive
         the public types through a chosen micro-kernel. -->
    <InternalsVisibleTo Include="Tensile.Tests" />
    <!-- The interop package pins view buffers itself, since it has its own
         native seam and does not go through Tensile.Kernels. -->
    <InternalsVisibleTo Include="Tensile.Interop.Blis" />
    <InternalsVisibleTo Include="Tensile.Benchmarks" />
    <InternalsVisibleTo Include="tensile-diag" />
  </ItemGroup>

</Project>
