<Project>

  <!--
    Settings shared by every project. Kept here rather than duplicated so that
    a change to the target framework or language version cannot apply to the
    library but not its tests, which is exactly the kind of skew that makes a
    benchmark or a test disagree with the thing it is measuring.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Off by default. The kernel assembly, and the test, benchmark and
         diagnostics projects that drive it directly, turn it on themselves.
         The public assembly never does: that is invariant I4 in
         docs/security-design.md, and it is held by the compiler rather than
         by review. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Every project restores against a committed packages.lock.json, and CI
         restores in locked mode, so the exact package graph that was reviewed
         is the one that builds. A new or bumped dependency shows up as a diff
         to the lock file, never silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Package metadata, for the projects that pack (Tensile, and Tensile.Interop.Blis
    if anyone packs it locally). The version here is a placeholder: the publish
    workflow sets the real one from the release tag, so a package can only
    carry a version that names a commit.
  -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Tim Raymond</Authors>
    <Copyright>Copyright (c) 2026, Tim Raymond</Copyright>
    <PackageProjectUrl>https://github.com/xfmrexpert/Tensile</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xfmrexpert/Tensile</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>

    <!--
      Debuggable from a consuming project: SourceLink (built into the .NET SDK
      for GitHub repositories) records the commit and the URL of every source
      file, and the PDB is embedded in each DLL rather than shipped as a
      separate symbols package, because GitHub Packages does not host symbol
      packages. Stepping into Tensile from the application then fetches the
      exact source the package was built from.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Deterministic paths in CI builds, so a package rebuilt from the same
       commit is the same package. Local builds keep real paths for debugging. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
