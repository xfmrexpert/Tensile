<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The package under test comes from the folder tests/package-smoke.sh packs
    into, and from nowhere else. nuget.org is deliberately absent: were a
    package called Tensile ever published there at the same version, a smoke
    test that could reach it might test that package instead of this one.
  -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
  </packageSources>
</configuration>
